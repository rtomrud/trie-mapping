{
  "name": "trie-mapping",
  "version": "5.0.0",
  "description": "A compact trie for mapping keys to values",
  "keywords": [
    "compact",
    "dictionary",
    "map",
    "prefix",
    "radix",
    "suffix",
    "tree",
    "trie"
  ],
  "homepage": "https://github.com/rtomrud/trie-mapping#readme",
  "bugs": {
    "url": "https://github.com/rtomrud/trie-mapping/issues"
  },
  "license": "MIT",
  "author": "Artem Rudenko <rtomrud@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rtomrud/trie-mapping.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config",
    "bench": "node bench/payload.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite-plus": "^1.6.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.2.2",
      "onFail": "download"
    }
  }
}
